# Copy to .env and adjust. Never commit the real .env file.
NODE_ENV=development
# 5001 because macOS uses port 5000 for AirPlay Receiver
PORT=5001
# Frontend origin allowed by CORS
CORS_ORIGIN=http://localhost:3000
# MongoDB connection string (local or MongoDB Atlas). Required in production.
MONGODB_URI=mongodb://127.0.0.1:27017/inventory_forecaster
# JWT secret key for signing authentication tokens. Required in production.
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d
